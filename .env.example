# Einstellungen des Soundboards (KEINE Zugangsdaten hier!)
# Zugangsdaten stehen in %USERPROFILE%\.claudemumble\zugang.env

# Port des Webinterfaces auf deinem PC: http://localhost:8080
HOST_PORT=8080

# Kanal, in den der Bot nach dem Verbinden geht (Pfad mit / fuer Unterkanaele, leer = Standardkanal)
MUMBLE_CHANNEL=
# Der Bot folgt diesem Benutzer automatisch von Kanal zu Kanal (leer = aus)
MUMBLE_FOLLOW_USER=Zasa
# Kommentar des Bots in Mumble (HTML erlaubt, leer = Standardtext mit Hilfe-Hinweis)
MUMBLE_COMMENT=

# Prefixe fuer Chat-Befehle, kommagetrennt
COMMAND_PREFIXES=/,!
# Wer /vol, /come, /follow, /unfollow nutzen darf (kommagetrennt, leer = alle)
ADMINS=
# Diese Benutzer werden ignoriert (kommagetrennt)
BLOCKED_USERS=
# Mindestabstand in Sekunden zwischen zwei Sounds pro Benutzer (Spam-Schutz)
COMMAND_COOLDOWN=1

# Wie viele Sounds gleichzeitig laufen duerfen und ob sie sich ueberlagern
MAX_VOICES=4
OVERLAP=true
# Start-Lautstaerke in Prozent (danach merkt sich der Bot die zuletzt gesetzte)
DEFAULT_VOLUME=70
# Opus-Bitrate in Bit/s (wird automatisch an das Server-Limit angepasst)
BITRATE=64000
# Sounds auf gleiche Lautheit bringen und Stille am Anfang/Ende entfernen
NORMALIZE=true
TRIM_SILENCE=true
# Laengere Sounds werden abgeschnitten
MAX_SOUND_SECONDS=300
# Unterordner im Sounds-Ordner, die ignoriert werden (Ordner mit _ oder . am Anfang immer)
IGNORE_DIRS=aussortiert
# Maximale Groesse pro Upload-Datei in MB
MAX_UPLOAD_MB=50

# --- Musik (YouTube & Co.) ---
# Start-Lautstaerke der Musik in Prozent (danach merkt sich der Bot die zuletzt gesetzte)
MUSIC_DEFAULT_VOLUME=50
# Musik-Lautstaerke in Prozent, waehrend ein Soundboard-Sound laeuft (Ducking, 100 = aus)
MUSIC_DUCK_VOLUME=25
# Musik auf gleichmaessige Lautheit bringen
MUSIC_NORMALIZE=true
# Neuen Titel im Chat ansagen ("Jetzt: ...")
MUSIC_ANNOUNCE=true
# Maximale Laenge pro Song in Minuten und maximale Anzahl Titel aus einer Playlist
MAX_TRACK_MINUTES=20
# Livestream pausieren, wenn ausser dem Bot so viele Minuten niemand im Kanal war (0 = nie)
LIVE_IDLE_MINUTES=5
MAX_PLAYLIST_ITEMS=100
# Clips (/clip): maximale Laenge in Sekunden und Zielordner im Sounds-Ordner
MAX_CLIP_SECONDS=60
CLIP_CATEGORY=YouTube Clips
# yt-dlp bei jedem Start aktualisieren (YouTube aendert regelmaessig Dinge)
YTDLP_AUTO_UPDATE=true

# --- Extras ---
# Join-Sounds an/aus und Mindestabstand pro Person in Sekunden
JOIN_SOUNDS=true
JOIN_SOUND_COOLDOWN=600
# Maximale Textlaenge fuer /tts
TTS_MAX_CHARS=300
# Pull-Timer: eigener Sound statt Kriegshorn (Name aus dem Soundboard, leer = Horn) und maximale Dauer
PULL_SOUND=
PULL_MAX_SECONDS=120

# --- Discord (zweiter Bot, startet nur mit Token in %USERPROFILE%\.claudemumble\discord.env) ---
# Port des Discord-Webinterfaces auf deinem PC: http://localhost:8081
DISCORD_HOST_PORT=8081
# Server, falls der Bot auf mehreren ist (Name oder ID, leer = der einzige)
DISCORD_GUILD=
# Sprachkanal, den der Bot nach dem Start betritt (Name, leer = erst auf !come oder ueber das Webinterface)
DISCORD_CHANNEL=
# Der Bot folgt diesem Discord-Benutzer (Anzeigename) automatisch von Kanal zu Kanal (leer = aus)
DISCORD_FOLLOW_USER=
# Textkanaele fuer !-Befehle, kommagetrennt (leer = alle; Direktnachrichten und Sprachkanal-Chats gehen immer)
DISCORD_TEXT_CHANNELS=
# Diese Discord-Rolle darf Admin-Befehle nutzen (Server-Admins immer; ohne Rolle und ADMINS = alle)
DISCORD_ADMIN_ROLE=

LOG_LEVEL=INFO
